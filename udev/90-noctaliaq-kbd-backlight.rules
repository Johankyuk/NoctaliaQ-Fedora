# NoctaliaQ: permite escribir brillo/color del teclado sin sudo (grupo video),
# igual que ya hace systemd por defecto para /sys/class/backlight.
# Requiere que tu usuario este en el grupo video: groups | grep video
# (si no: sudo usermod -aG video "$USER" y volver a iniciar sesion).
SUBSYSTEM=="leds", KERNEL=="asus::kbd_backlight", ACTION=="add", \
  RUN+="/bin/chmod 664 /sys/class/leds/%k/brightness", \
  RUN+="/bin/chgrp video /sys/class/leds/%k/brightness"

SUBSYSTEM=="leds", KERNEL=="asus::kbd_backlight", ACTION=="add", \
  TEST=="kbd_rgb_mode", \
  RUN+="/bin/chmod 664 /sys/class/leds/%k/kbd_rgb_mode", \
  RUN+="/bin/chgrp video /sys/class/leds/%k/kbd_rgb_mode"

# Interfaz legacy (kernels viejos): mismo trato para /sys/devices/platform/asus-nb-wmi/kbbl/*
SUBSYSTEM=="platform", KERNEL=="asus-nb-wmi", ACTION=="add", \
  RUN+="/bin/sh -c 'chgrp video /sys/devices/platform/asus-nb-wmi/kbbl/kbbl_* 2>/dev/null; chmod 664 /sys/devices/platform/asus-nb-wmi/kbbl/kbbl_* 2>/dev/null; exit 0'"
