{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/noctaliaq.txt",
        "color": { "1": "green" },
        "padding": { "top": 1, "right": 2 }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        { "type": "kernel",   "key": " Kernel" },
        { "type": "uptime",   "key": " Uptime" },
        { "type": "shell",    "key": " Shell" },
        { "type": "memory",   "key": " Mem" },
        { "type": "packages", "key": " Pkgs" },
        { "type": "user",     "key": " User" },
        { "type": "host",     "key": " Host" },
        { "type": "os",       "key": " Distro" }
    ]
}
